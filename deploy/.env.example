# Copy this file to deploy/.env and fill in real values before `docker compose up`.
# Never commit the real deploy/.env file.

POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=changeme-generate-a-real-password
POSTGRES_DB=expense_tracker

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Generate with: openssl rand -base64 32
# IMPORTANT: back this up somewhere safe outside the Pi. If it's lost, every
# vault entry (passwords/cards) becomes permanently undecryptable.
VAULT_ENCRYPTION_KEY=

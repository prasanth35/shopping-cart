# Postgres connection string used by Prisma
DATABASE_URL="postgresql://expense_tracker:changeme@localhost:5432/expense_tracker?schema=public"

# Port the API listens on
PORT=4000

# Long random secret used to sign JWT session cookies. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-output-of-openssl-rand--base64-48"

# 32-byte key (base64) used to encrypt the password/card vault with AES-256-GCM.
# Generate with:
#   openssl rand -base64 32
# IMPORTANT: back this up somewhere safe (e.g. a physical note or separate password manager).
# If this key is lost, every vault entry becomes permanently undecryptable.
VAULT_ENCRYPTION_KEY="replace-with-output-of-openssl-rand--base64-32"

# Set to "production" when deployed
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# Not needed when the frontend and backend are served same-origin via nginx (see deploy/).
CORS_ORIGIN="http://localhost:5173"
